{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "VBit Inlay Documentation",
  "colors": {
    "primary": "#393939",
    "light": "#FF0000",
    "dark": "#006FFE"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "VBit Inlay Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "installation",
              "video_references"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      }
    ]
    },
  "logo": {
    "light": "/logo/corbins_workshop_rectangle_logo.svg",
    "dark": "/logo/corbins_workshop_rectangle_logo.svg",
    "href": "https://www.corbinsworkshop.com"   
  },
  "navbar": {
    "links": [
      {
        "label": "Support Email",
        "href": "mailto:corbin@corbinsworkshop.com"
      }
    ],
    "primary": {  
      "type": "button",
      "label": "Back to Corbin's Workshop",
      "href": "https://www.corbinsworkshop.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "appearance": {
    "default": "light",
    "strict": true
  }
}
